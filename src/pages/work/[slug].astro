---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../data';

export async function getStaticPaths() {
  const work = await getCollection('work');
  return work.filter((w) => w.data.hasPage).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={`${d.title}, Glen Hutajulu`} description={d.tagline} image={d.demo ? '/og.png' : undefined}>
  <article class="case">
    <header>
      <h1>{d.title}</h1>
      <p>{d.tagline}</p>
    </header>

    <section class="tldr" aria-label="Project summary">
      <dl>
        <div class="wide"><dt>Problem</dt><dd>{d.problem}</dd></div>
        <div class="wide"><dt>Outcome</dt><dd>{d.outcome}</dd></div>
        <div><dt>Role</dt><dd>{d.role}</dd></div>
        {d.team && <div><dt>Team</dt><dd>{d.team}</dd></div>}
        <div><dt>Timeline</dt><dd>{d.timeline}</dd></div>
      </dl>
      {d.demo && site.demo && <p class="demo"><a href={site.demo}>Open the demo with dummy data</a></p>}
    </section>

    {d.cover && (
      <figure class="cover">
        <img src={d.cover} alt={d.coverAlt ?? ''} width={d.coverWidth} height={d.coverHeight} />
      </figure>
    )}

    <div class="prose"><Content /></div>

    {d.gallery.length > 0 && (
      <section class="gallery" aria-label="More screens">
        {d.gallery.map((shot) => (
          <figure>
            <img src={shot.src} alt={shot.alt} width="2560" height="1600" loading="lazy" decoding="async" />
            {shot.caption && <figcaption>{shot.caption}</figcaption>}
          </figure>
        ))}
      </section>
    )}

    <p class="back"><a href="/#work">Back to all work</a></p>
  </article>
</Base>

<style>
  .case header { padding-block: clamp(28px, 6vw, 72px) 28px; }
  .case h1 { font-size: clamp(42px, 7vw, 92px); line-height: 0.98; letter-spacing: -0.04em; font-weight: 800; }
  .case header p { margin-top: 14px; font-size: clamp(19px, 2vw, 24px); color: var(--soft); max-width: 40ch; line-height: 1.3; }
  .tldr { padding-block: 22px; border-block: 1px solid var(--ink); }
  .tldr dl { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px 40px; }
  .tldr .wide { grid-column: span 3; max-width: 70ch; }
  .tldr dt { font-size: 14px; color: var(--soft); }
  .demo { margin-top: 18px; font-weight: 600; }
  .cover { margin-top: 28px; border-radius: 10px; overflow: hidden; background: var(--line); }
  .cover img { width: 100%; }
  .prose { max-width: 66ch; margin: 44px auto 0; }
  .prose :global(h2) { font-size: clamp(25px, 3vw, 32px); margin-top: 44px; margin-bottom: 10px; }
  .prose :global(p) { margin-top: 12px; }
  .prose :global(ul) { padding-left: 22px; margin: 12px 0 0; }
  .prose :global(li) { margin-top: 6px; }
  .gallery { display: grid; gap: 32px; margin-top: 56px; }
  .gallery img { width: 100%; border-radius: 10px; }
  .gallery figcaption { margin-top: 8px; font-size: 16px; color: var(--soft); }
  .back { margin-top: 48px; }
  @media (max-width: 720px) {
    .tldr dl { grid-template-columns: minmax(0, 1fr); }
    .tldr .wide { grid-column: auto; }
  }
</style>
