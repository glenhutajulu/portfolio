---
import Base from '../layouts/Base.astro';
---
<Base
  title="Website design services, Glen Hutajulu"
  description="Alongside product work, I design and build websites for companies in Indonesia and the US, end to end."
>
  <div class="wrap">

    <section class="page-head">
      <h1 class="h-giant">services</h1>
      <p class="lede lede-wide mt-28">Alongside product work, I design and build websites for companies in Indonesia and the US, end to end.</p>
    </section>

    <section class="band band-pull band-tight mt-xl grain">
      <div class="grid grid-280">
        <div class="card grain">
          <p class="label">Step 01</p>
          <h2 class="h-step mt-12">consulting</h2>
          <p class="soft mt-14">I ask about your goals, design preferences and target audience. This is the foundation of our work together.</p>
        </div>
        <div class="card grain">
          <p class="label">Step 02</p>
          <h2 class="h-step mt-12">discovery</h2>
          <p class="soft mt-14">I study your closest competitors and industry leaders to find a fitting visual style and tone of voice.</p>
        </div>
        <div class="card grain">
          <p class="label">Step 03</p>
          <h2 class="h-step mt-12">structure</h2>
          <p class="soft mt-14">You get a draft of your future website, straight from the Figma file.</p>
        </div>
        <div class="card grain">
          <p class="label">Step 04</p>
          <h2 class="h-step mt-12">polishing</h2>
          <p class="soft mt-14">I add high-fidelity visuals and interactive elements so the site looks and feels finished.</p>
        </div>
        <div class="card grain">
          <p class="label">Step 05</p>
          <h2 class="h-step mt-12">review</h2>
          <p class="soft mt-14">You review and give feedback, and I iterate until the design meets your needs.</p>
        </div>
        <div class="card grain">
          <p class="label">Step 06</p>
          <h2 class="h-step mt-12">delivery</h2>
          <p class="soft mt-14">I build the site and hand it over, so you can keep it up to date yourself.</p>
        </div>
      </div>
    </section>

  </div>
</Base>
