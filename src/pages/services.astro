import Base from '../layouts/Base.astro';
---
<Base
  title="Website design services, Glen Hutajulu"
  description="Alongside product work, I design and build websites for companies worldwide, end to end."
>
<article>
<section class="cs-hero" aria-label="Services">
<p class="cs-kick mono"><span class="sq" style="color: var(--acc)"></span>Services · Website design and build</p>
<h1 class="cs-name px-font intro" aria-label="Services"><span aria-hidden="true"><span class="c" style="--i: 0">s</span><span class="c" style="--i: 1">e</span><span class="c" style="--i: 2">r</span><span class="c" style="--i: 3">v</span><span class="c" style="--i: 4">i</span><span class="c" style="--i: 5">c</span><span class="c" style="--i: 6">e</span><span class="c" style="--i: 7">s</span></span></h1>
<p class="pg-lede rv">Alongside product work, I design and build websites for companies worldwide, end to end.</p>
</section>
<ol class="steps" aria-label="How a website project runs">
<li class="rv"><span class="mono">Step 01</span><h2 class="px-font">consulting</h2><p>I ask about your goals, design preferences and target audience. This is the foundation of our work together.</p></li>
<li class="rv"><span class="mono">Step 02</span><h2 class="px-font">discovery</h2><p>I study your closest competitors and industry leaders to find a fitting visual style and tone of voice.</p></li>
<li class="rv"><span class="mono">Step 03</span><h2 class="px-font">structure</h2><p>You get a draft of your future website, straight from the Figma file.</p></li>
<li class="rv"><span class="mono">Step 04</span><h2 class="px-font">polishing</h2><p>I add high-fidelity visuals and interactive elements so the site looks and feels finished.</p></li>
<li class="rv"><span class="mono">Step 05</span><h2 class="px-font">review</h2><p>You review and give feedback, and I iterate until the design meets your needs.</p></li>
<li class="rv"><span class="mono">Step 06</span><h2 class="px-font">delivery</h2><p>I build the site and hand it over, so you can keep it up to date yourself.</p></li>
</ol>
