---
import Base from '../layouts/Base.astro';
import { site } from '../data';
---
<Base
  title="Glen Hutajulu, Product Designer"
  description="Product Designer for AI-powered, data-heavy products, across telco, banking and consumer finance. Based in Jakarta, working remotely (GMT+7)."
  heroHeader
>
  <span class="m-pill" aria-hidden="true">Case study ↗</span>
  <div class="hero">
    <img class="hero-bg" src="/img/hero-bg.webp" alt="" width="2560" height="1440" decoding="async" fetchpriority="high">
    <div class="hero-inner">

      <div class="m-slot"></div>

      <section class="hero-main">
        <span class="dot" aria-hidden="true" style="left: 4.5%; top: 5%; background: #1E3A5F"></span>
        <span class="dot" aria-hidden="true" style="left: 61%; top: 7%; background: #B8892B"></span>
        <span class="dot" aria-hidden="true" style="left: 97%; top: 5%; background: #4A5D6E"></span>
        <span class="dot" aria-hidden="true" style="left: 67%; top: 44%; background: #6E2A2A"></span>
        <span class="dot" aria-hidden="true" style="left: 95%; top: 38%; background: #2F5D46"></span>
        <span class="dot" aria-hidden="true" style="left: 58%; top: 62%; background: #6B7A2E"></span>
        <span class="dot" aria-hidden="true" style="left: 46%; top: 92%; background: #F0873B"></span>

        <div class="rel">
          <p class="hero-title">glen hutajulu</p><h1 class="hero-title">product designer</h1>
          <div class="chips">
            <span class="chip">AI/LLM UX</span>
            <span class="chip">Dashboards</span>
            <span class="chip">Fintech</span>
            <span class="chip">Telco</span>
            <span class="chip">Research</span>
          </div>
        </div>

        <div class="hero-foot">
          <div class="hero-tag">
            <p class="hero-lede">for AI-powered, data-heavy products. I turn complex enterprise data into tools people can act on.</p>
            <p class="label label-lg mt-14">Based in Jakarta, working remotely (GMT+7)</p>
          </div>
          <div class="hero-side">
            <img class="crop crop-center ratio-16-10 hero-portrait" src="/img/hero-portrait.webp" alt="Portrait of Glen Hutajulu" width="1200" height="750" decoding="async">
            <div class="hero-cta">
              <a class="btn btn-dark" href="#work">View work<span class="m-ar"><span>↗</span><span aria-hidden="true">↗</span></span></a>
              {site.cv && <a class="btn btn-light" href={site.cv} download>Download CV</a>}
              <a class="btn btn-light" href="https://www.linkedin.com/in/glenhutajulu/">LinkedIn</a>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>

  <div class="wrap">

    <section class="work-top" id="work">
      <h2 class="h-display">selected works</h2>

      <div class="work-grid">

        <article class="cell">
          <a class="tile" href="/work/energy-analytics">
            <img class="crop crop-tl ratio-4-3" src="/work/arsenal/cover.webp" alt="Voltwise dashboard with KPI cards and a site map" width="2560" height="1600" decoding="async" loading="lazy">
          </a>
          <div class="tile-meta">
            <h3 class="tile-title"><a href="/work/energy-analytics">arsenal</a></h3>
            <span class="label">AI analytics, telco, Oct 2025 – Oct 2026</span>
          </div>
          <p class="tile-blurb">Sole designer on an LLM-powered analytics platform for around 60,000 telco tower sites, from concept to pre-launch.</p>
        </article>

        <article class="cell">
          <a class="tile" href="/work/fifgo">
            <img class="crop crop-center ratio-4-3" src="/work/fifgo/cover.webp" alt="FIFGO app on a phone beside the FIFGROUP website on a laptop" width="2400" height="1600" decoding="async" loading="lazy">
          </a>
          <div class="tile-meta">
            <h3 class="tile-title"><a href="/work/fifgo">fifgo and fifgroup</a></h3>
            <span class="label">Consumer finance, Sep 2023 – Feb 2024</span>
          </div>
          <p class="tile-blurb">A customer app and public website revamp. In UAT, users completed the loan flow in under 7 minutes with zero drop-off.</p>
        </article>

        <article class="cell">
          <a class="tile" href="/work/orbit">
            <img class="crop crop-center ratio-4-3" src="/work/orbit/tile.webp" alt="Telkomsel Orbit website on a laptop beside two phones" width="1600" height="1200" decoding="async" loading="lazy">
          </a>
          <div class="tile-meta">
            <h3 class="tile-title"><a href="/work/orbit">telkomsel orbit</a></h3>
            <span class="label">Telco, Mar 2024 – Nov 2024</span>
          </div>
          <p class="tile-blurb">A website revamp for a fixed wireless internet service, simplifying navigation and the login, purchase and modem pairing flows.</p>
        </article>

        <article class="cell">
          <a class="tile" href="/work/byu">
            <img class="crop crop-center ratio-4-3" src="/work/byu/tile.webp" alt="Three phones showing the byU app home, help centre and topic screens" width="1600" height="1200" decoding="async" loading="lazy">
          </a>
          <div class="tile-meta">
            <h3 class="tile-title"><a href="/work/byu">byU complaint journey</a></h3>
            <span class="label">Telco research, Dec 2022 – Feb 2023</span>
          </div>
          <p class="tile-blurb">UX research that recommended showing the default fix first and cutting the bot flow from 10 questions to 7.</p>
        </article>

      </div>
    </section>

    <section class="more-top">
      <div class="more">
        <h2 class="h-display h-display-flush">more work</h2>
        <div class="more-list">
          <a class="row" href="https://groupbintang.com/" target="_blank" rel="noopener">
            <span class="row-title">bintang manunggal pratama</span>
            <span class="label row-meta">Corporate website, 2024<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.5" stroke-linecap="square" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg></span>
        </a>
        <a class="row" href="https://shilohcore.framer.ai/" target="_blank" rel="noopener">
          <span class="row-title">shilohcore</span>
          <span class="label row-meta">Company website, 2025<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="1.5" stroke-linecap="square" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg></span>
      </a>
      <p class="soft mt-18">Need a website rather than a product designer? <a href="/services">See how I work with clients</a>.</p>
    </div>
  </div>
</section>

<section class="band band-pull band-roomy mt-xxl grain">
  <h2 class="h-display">how i work</h2>
  <div class="grid grid-280">
    <div class="card card-stack grain">
      <p class="label">Step 01</p>
      <h3 class="h-step mt-12">understand</h3>
      <p class="soft mt-14 mb-20">Stakeholder interviews, user interviews and journey mapping, turned into user stories and information architecture.</p>
      <img class="crop crop-center ratio-3-2 mt-auto" src="/img/step-understand.webp" alt="Illustration of a user speaking beside a journey map, interview notes and a sticky note" width="1440" height="960" decoding="async" loading="lazy">
    </div>
    <div class="card card-stack grain">
      <p class="label">Step 02</p>
      <h3 class="h-step mt-12">design</h3>
      <p class="soft mt-14 mb-20">Flows, high-fidelity UI and prototypes, with design rationale presented directly to stakeholders.</p>
      <img class="crop crop-center ratio-3-2 mt-auto" src="/img/step-design.webp" alt="Illustration of one screen going from wireframe to grey layout to final UI" width="1440" height="960" decoding="async" loading="lazy">
    </div>
    <div class="card card-stack grain">
      <p class="label">Step 03</p>
      <h3 class="h-step mt-12">validate</h3>
      <p class="soft mt-14 mb-20">Usability testing, then handoff to engineers, data scientists and QA.</p>
      <img class="crop crop-center ratio-3-2 mt-auto" src="/img/step-validate.webp" alt="Illustration of a phone being tapped between a checklist and a code panel" width="1440" height="960" decoding="async" loading="lazy">
    </div>
  </div>
</section>

</div>
</Base>
